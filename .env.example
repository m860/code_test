# code_test API
PORT=3100

# Code Sentry ingest (create app in Code Sentry admin → webhookToken)
CODE_SENTRY_BASE_URL=http://localhost:3001
CODE_SENTRY_WEBHOOK_TOKEN=
CODE_SENTRY_ENVIRONMENT=test
CODE_SENTRY_SERVICE=code-test-api

# Demo: random failure rate on place-order (0–1). List uses half of this.
# Set 0 for stable success path; 1 to always fail random chaos.
DEMO_FLAKY_RATE=0.35

# Web (Vite) — optional override; default proxies /v1 → localhost:3100
VITE_API_BASE_URL=
